@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StreetCode</title>
    <meta name="description" content="StreetCode — notes on building AI systems, by Roberto Galdamez." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600;6..72,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-nav">
        <div class="nav-inner">
            <a class="wordmark" asp-area="" asp-controller="Home" asp-action="Index">StreetCode</a>
            <nav class="nav-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a asp-area="" asp-controller="Posts" asp-action="Index">Posts</a>
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="btn btn-accent btn-sm" asp-area="" asp-controller="Posts" asp-action="Create">+ New Post</a>
                    <form class="nav-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="nav-link-btn">Log out</button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login">Log in</a>
                }
            </nav>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <span>StreetCode — by Roberto Galdamez</span>
            <span class="footer-links">
                <a href="https://www.linkedin.com/in/roberto-galdamez/" target="_blank" rel="noopener">LinkedIn</a>
                <a href="https://github.com/robdreamville" target="_blank" rel="noopener">GitHub</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
