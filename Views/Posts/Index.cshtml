@model IEnumerable<LetsChatFinal.Models.Post>
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Posts";
}

<section class="section">
    <div class="wrap-narrow">
        <div class="list-header">
            <div>
                <span class="eyebrow">StreetCode</span>
                <h2 style="margin:0">All posts</h2>
            </div>
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="btn btn-accent btn-sm" asp-action="Create">+ New Post</a>
            }
        </div>

        @if (Model != null && Model.Any())
        {
            <ul class="post-list">
                @foreach (var item in Model.OrderByDescending(p => p.Created))
                {
                    <li class="post-row">
                        <span class="post-date">@item.Created.ToString("MMMM d, yyyy")</span>
                        <h3><a asp-action="Details" asp-route-id="@item.Id">@(string.IsNullOrWhiteSpace(item.Title) ? "(untitled)" : item.Title)</a></h3>
                        <p class="post-excerpt">@item.Content</p>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="post-row-actions">
                                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" style="color:#b3261e">Delete</a>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="empty-note">No posts yet.</p>
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="btn btn-accent" asp-action="Create">Write the first one</a>
            }
        }
    </div>
</section>
