@model LetsChatFinal.Models.Post
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Title) ? "Untitled" : Model.Title;
}

<article class="article">
    <div class="wrap-narrow">
        <h1 class="article-title">@(string.IsNullOrWhiteSpace(Model.Title) ? "Untitled" : Model.Title)</h1>
        <div class="article-meta">
            By Roberto Galdamez &middot; @Model.Created.ToString("MMMM d, yyyy")
        </div>

        <div class="article-body">@Model.Content</div>

        @if (SignInManager.IsSignedIn(User))
        {
            <div class="article-actions">
                <a class="btn btn-outline btn-sm" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                <a class="btn btn-danger-ghost btn-sm" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
            </div>
        }

        <a class="back-link" asp-action="Index">&larr; All posts</a>
    </div>
</article>
