@model LetsChatFinal.Models.Post

@{
    ViewData["Title"] = "Delete Post";
}

<section class="section">
    <div class="wrap-narrow">
        <span class="eyebrow">~/streetcode</span>
        <h2 style="margin:0 0 0.5rem">Delete this post?</h2>
        <p class="section-sub">This can't be undone.</p>

        <div class="form-card">
            <h3 style="margin-top:0">@Model.Title</h3>
            <span class="post-date">@Model.Created.ToString("MMMM d, yyyy")</span>
            <p class="post-excerpt" style="-webkit-line-clamp: 5">@Model.Content</p>

            <form asp-action="Delete" style="margin-top:1.8rem; display:flex; gap:0.8rem;">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Yes, delete it" class="btn btn-danger-ghost" />
                <a asp-action="Index" class="btn btn-outline">Keep it</a>
            </form>
        </div>
    </div>
</section>
