@model LetsChatFinal.Models.Post

@{
    ViewData["Title"] = "Edit Post";
}

<section class="section">
    <div class="wrap-narrow">
        <span class="eyebrow">StreetCode</span>
        <h2 style="margin:0 0 0.5rem">Edit post</h2>

        <div class="form-card">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="field">
                    <label asp-for="Title">Title (optional)</label>
                    <input asp-for="Title" type="text" autocomplete="off" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Content">Content</label>
                    <textarea asp-for="Content"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
                <div class="field" style="margin-bottom:0">
                    <input type="submit" value="Save changes" class="btn btn-accent" />
                    <a asp-action="Index" style="margin-left:1rem">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
