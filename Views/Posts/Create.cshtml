@model LetsChatFinal.Models.Post

@{
    ViewData["Title"] = "New Post";
}

<section class="section">
    <div class="wrap-narrow">
        <span class="eyebrow">StreetCode</span>
        <h2 style="margin:0 0 0.5rem">Write a post</h2>
        <p class="section-sub">Say what you want to say — it'll go live the second you hit publish.</p>

        <div class="form-card">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="field">
                    <label asp-for="Title">Title</label>
                    <input asp-for="Title" type="text" placeholder="Give it a headline..." autocomplete="off" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="Content">Content</label>
                    <textarea asp-for="Content" placeholder="Write it like you'd say it..."></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                    <div class="hint">Line breaks are kept as-is — paste straight from LinkedIn if you want.</div>
                </div>
                <div class="field" style="margin-bottom:0">
                    <input type="submit" value="Publish" class="btn btn-accent" />
                    <a asp-action="Index" style="margin-left:1rem">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
